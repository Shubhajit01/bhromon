{
  "name": "bhromon",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:generate": "better-auth generate --output src/db/auth.schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.10.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@formkit/tempo": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "latest",
    "@types/ms": "^2.1.0",
    "agents": "^0.20.1",
    "ai": "^7.0.48",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "es-toolkit": "^1.50.0",
    "ms": "^2.1.3",
    "react": "^19.2.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.0",
    "react-timeago": "^8.3.0",
    "shadcn": "^4.16.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "vite-imagetools": "^10.0.1",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.115.0"
